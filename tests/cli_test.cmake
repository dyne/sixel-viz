file(MAKE_DIRECTORY "${work}")
if(DEFINED build)
  set(stage "${work}/stage")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" --install "${build}" --config "${config}" --prefix "${stage}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Staged install exited ${status}\n${out}\n${err}")
  endif()
  set(program "${stage}/${bindir}/si${exe_suffix}")
endif()

set(banner "Sixel-Viz ${version} by Jaromil - Copyright (C) 2026 Dyne.org foundation\n")
set(usage "Usage: si [--] INPUT...\n       si --help\n       si --version\n")
set(expected_err "${banner}")
set(expect_picture FALSE)
if(case_name MATCHES "^(help|version)$")
  set(args "--${case_name}")
  set(expected_status 0)
  set(expected_err "")
elseif(case_name MATCHES "^(no_operand|unknown_extra_option|unknown_option)$")
  if(case_name STREQUAL "unknown_extra_option")
    set(args first.gif --unknown)
  elseif(case_name STREQUAL "unknown_option")
    set(args --unknown)
  endif()
  set(expected_status 2)
  set(expected_err "${banner}${usage}")
elseif(case_name STREQUAL "invalid_cell_override")
  set(command_prefix "${CMAKE_COMMAND}" -E env SI_CELL_SIZE=10x0)
  set(args "${CMAKE_CURRENT_LIST_DIR}/fixtures/two-colors.svg")
  set(expected_status 2)
  set(expected_err "${banner}si: SI_CELL_SIZE must be WIDTHxHEIGHT in positive integer pixels\n${usage}")
elseif(case_name MATCHES "^(missing_file|directory)$")
  if(case_name STREQUAL "missing_file")
    set(name "missing file.gif")
    set(expected_err "${banner}si: cannot open '${name}' as a local file\n")
  else()
    set(name "a directory")
    file(MAKE_DIRECTORY "${work}/${name}")
    set(expected_err "${banner}si: no displayable media found\n")
  endif()
  set(args "${name}")
  set(expected_status 1)
elseif(case_name MATCHES "^(spaces|unicode|end_options|still|anamorphic|playback_gif)$")
  set(verification_mode raster)
  if(case_name STREQUAL "still")
    set(name "two-colors.svg")
    set(fixture "two-colors.svg")
  elseif(case_name STREQUAL "anamorphic")
    set(name "anamorphic.png")
    set(fixture "anamorphic.png")
    set(verification_mode raster_anamorphic)
    set(command_prefix "${CMAKE_COMMAND}" -E env SI_CELL_SIZE=1x1)
  elseif(case_name STREQUAL "playback_gif")
    set(name "once-disposal.gif")
    set(fixture "${name}")
    set(verification_mode redirected_bytes)
  elseif(case_name STREQUAL "spaces")
    set(name "a file with spaces.gif")
  elseif(case_name STREQUAL "unicode")
    set(name "夜空 🌌.gif")
  else()
    set(name "--help")
    set(terminator --)
  endif()
  if(NOT DEFINED fixture)
    set(fixture "two-colors.gif")
  endif()
  configure_file("${CMAKE_CURRENT_LIST_DIR}/fixtures/${fixture}" "${work}/${name}" COPYONLY)
  set(args ${terminator} "${name}")
  set(expected_status 0)
  set(expect_picture TRUE)
else()
  message(FATAL_ERROR "Unknown CLI test case '${case_name}'")
endif()

set(capture "${work}/stdout")
execute_process(
  COMMAND ${command_prefix} "${program}" ${args} WORKING_DIRECTORY "${work}"
  RESULT_VARIABLE status OUTPUT_FILE "${capture}" ERROR_VARIABLE err ENCODING NONE)
if(expect_picture)
  execute_process(COMMAND "${verify}" "${verification_mode}" stdout WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE verification OUTPUT_VARIABLE raster ERROR_VARIABLE detail)
  if(NOT verification STREQUAL "0")
    message(FATAL_ERROR "${case_name} raster verification failed\n${raster}\n${detail}\n${err}")
  endif()
  message(STATUS "${raster}")
  set(out "")
else()
  file(READ "${capture}" out)
endif()
string(REPLACE "\r\n" "\n" out "${out}")
string(REPLACE "\r\n" "\n" err "${err}")
if(NOT status STREQUAL expected_status OR NOT err STREQUAL expected_err)
  message(FATAL_ERROR
    "${case_name} exited '${status}' (expected '${expected_status}')\n"
    "stdout [${out}]\n"
    "stderr [${err}] (expected [${expected_err}])")
endif()
if(case_name MATCHES "^(help|version)$")
  string(FIND "${out}" "${banner}" banner_offset)
  if(NOT banner_offset EQUAL 0)
    message(FATAL_ERROR "Expected the build banner before ${case_name} output.\n${out}")
  endif()
  string(LENGTH "${banner}" banner_size)
  string(SUBSTRING "${out}" ${banner_size} -1 details)
  if(case_name STREQUAL "help")
    string(FIND "${details}" "${usage}" usage_offset)
    if(NOT usage_offset EQUAL 1 OR NOT details MATCHES "Options:\n" OR
       NOT details MATCHES "SI_CELL_SIZE=WIDTHxHEIGHT" OR NOT details MATCHES "Examples:\n")
      message(FATAL_ERROR "Expected usage, options, environment and examples.\n${out}")
    endif()
  else()
    string(FIND "${details}" "Dyne musl SDK: ${musl_sdk}\n" sdk_offset)
    if(NOT sdk_offset EQUAL 0 OR
       NOT details MATCHES "^Dyne musl SDK: [^\n]+\nFFmpeg: [^\n]+\nlibsixel: [^\n]+\n$")
      message(FATAL_ERROR "Expected the Dyne musl SDK, FFmpeg and libsixel versions.\n${out}")
    endif()
  endif()
elseif(NOT out STREQUAL "")
  message(FATAL_ERROR "Unexpected stdout for ${case_name}.\n${out}")
endif()
message(STATUS "${case_name} exit ${status}, stdout and stderr matched")
